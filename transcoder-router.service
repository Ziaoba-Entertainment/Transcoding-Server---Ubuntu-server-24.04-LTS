[Unit]
Description=Transcoder Job Router Service
After=network.target redis.service

[Service]
Type=simple
User=media
Group=media
EnvironmentFile=-/etc/transcoder/env
WorkingDirectory=/opt/transcoder
ExecStart=/opt/transcoder/venv/bin/python /opt/transcoder/job_router.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
