[Unit]
Description=Transcoder Router Service
After=network.target redis.service

[Service]
Type=simple
User=media
Group=media
WorkingDirectory=/opt/transcoder
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/transcoder/venv/bin/python /opt/transcoder/job_router.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
