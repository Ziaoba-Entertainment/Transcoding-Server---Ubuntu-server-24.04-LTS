[Unit]
Description=Transcoder Worker Service
After=network.target redis.service

[Service]
Type=simple
User=media
Group=media
EnvironmentFile=-/etc/transcoder/env
EnvironmentFile=-/etc/ziaoba/redis.env
WorkingDirectory=/opt/transcoder
ExecStart=/opt/transcoder/venv/bin/python /opt/transcoder/transcoder_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
