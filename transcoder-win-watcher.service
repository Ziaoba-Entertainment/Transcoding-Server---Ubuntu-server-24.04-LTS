[Unit]
Description=Transcoder Windows Output Watcher Service
After=network.target redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/transcoder
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/transcoder/venv/bin/python /opt/transcoder/win_output_watcher.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
