@echo off
setlocal EnableExtensions DisableDelayedExpansion

echo =======================================================
echo Windows Transcoder Worker Setup
echo =======================================================

:: 1. Check for Python
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Python is not installed or not in PATH.
    echo Please install Python 3.10+ from python.org
    pause
    exit /b 1
)

:: 2. Install Dependencies
echo Installing Python dependencies...
python -m pip install --upgrade pip
python -m pip install redis psutil requests
if %errorlevel% neq 0 (
    echo ERROR: Failed to install dependencies.
    pause
    exit /b 1
)

:: 3. Create Directories
if not exist "C:\transcoder" mkdir "C:\transcoder"
if not exist "C:\transcoder\logs" mkdir "C:\transcoder\logs"

:: 4. Map Network Drives
echo Mapping network drives...
:: Hardcoded SMB Credentials
set SMB_USER=transcoder
set SMB_PASS=TranscoderSMB2024!
set SOURCE_SHARE=\\192.168.0.103\media_raw
set OUTPUT_SHARE=\\192.168.0.103\win_output

net use Z: /delete /y >nul 2>&1
net use Z: %SOURCE_SHARE% /user:%SMB_USER% %SMB_PASS% /persistent:yes
if %errorlevel% neq 0 echo WARNING: Failed to map Z: drive.

net use Y: /delete /y >nul 2>&1
net use Y: %OUTPUT_SHARE% /user:%SMB_USER% %SMB_PASS% /persistent:yes
if %errorlevel% neq 0 echo WARNING: Failed to map Y: drive.

:: 5. Write windows_worker.py using PowerShell Here-String
echo Writing windows_worker.py...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$content = @'`nimport os`nimport time`nimport json`nimport redis`nimport logging`nimport subprocess`nimport socket`nimport uuid`nimport shutil`nimport re`nfrom datetime import datetime`nfrom concurrent.futures import ThreadPoolExecutor`n`nVERSION = '2.3.0'`n`n# HARDCODED CREDENTIALS`nREDIS_HOST = '192.168.0.103'`nREDIS_PORT = 6379`nREDIS_PASSWORD = 'TranscoderRedis2024!'`n`n# REDIS KEYS`nWINDOWS_QUEUE = 'windows_transcode_queue'`nWIN_HEARTBEAT_KEY = 'worker:windows:heartbeat'`nWIN_ACTIVE_JOB_KEY = 'active_transcode_job:windows'`nWIN_LOG_CHANNEL = 'logs:windows'`nHISTORY_PREFIX = 'job_history:'`n`n# PATHS`nLOG_FILE = r'C:\\transcoder\\logs\\worker.log'`nFFMPEG_PATH = 'ffmpeg.exe'`n`n# STREAM CONFIGURATION (Balanced: GPU 0=1080p+360p, GPU 1=720p+480p)`nSTREAMS = [`n    {'name':'1080p','gpu':0,'w':1920,'h':1080,'vb':'2500k','maxr':'3750k','bufs':'5000k','idx':0},`n    {'name':'720p', 'gpu':1,'w':1280,'h':720, 'vb':'1500k','maxr':'2250k','bufs':'3000k','idx':1},`n    {'name':'480p', 'gpu':1,'w':854, 'h':480, 'vb':'800k', 'maxr':'1200k','bufs':'1600k','idx':2},`n    {'name':'360p', 'gpu':0,'w':640, 'h':360, 'vb':'500k', 'maxr':'750k', 'bufs':'1000k','idx':3},`n]`n`n# Setup logging`nclass RedisHandler(logging.Handler):`n    def __init__(self, redis_client):`n        super().__init__()`n        self.r = redis_client`n    def emit(self, record):`n        try:`n            msg = self.format(record)`n            self.r.publish(WIN_LOG_CHANNEL, msg)`n        except: pass`n`nlogging.basicConfig(`n    level=logging.INFO,`n    format='%%(asctime)s [WIN_WORKER] %%(levelname)s - %%(message)s',`n    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler()]`n)`nlogger = logging.getLogger(__name__)`n`nr = redis.Redis(host=REDIS_HOST, port=REDIS_PORT, password=REDIS_PASSWORD, decode_responses=True)`n# Add RedisHandler to root logger to catch all logs`nredis_h = RedisHandler(r)`nredis_h.setFormatter(logging.Formatter('%%(asctime)s [WIN_WORKER] %%(levelname)s - %%(message)s'))`nlogging.getLogger().addHandler(redis_h)`n`ndef get_gpu_stats():`n    try:`n        nvsmi = r\"C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvidia-smi.exe\"`n        if not os.path.exists(nvsmi): nvsmi = \"nvidia-smi\"`n        cmd = [nvsmi, '--query-gpu=index,utilization.gpu,memory.used,memory.total', '--format=csv,noheader,nounits']`n        output = subprocess.check_output(cmd, timeout=5).decode().strip()`n        gpus = []`n        for line in output.split('\\n'):`n            if not line.strip(): continue`n            parts = line.split(', ')`n            if len(parts) == 4:`n                idx, util, mem_used, mem_total = parts`n                gpus.append({`n                    'id': int(idx),`n                    'utilization': int(util),`n                    'memory_used': int(mem_used),`n                    'memory_total': int(mem_total)`n                })`n        return gpus`n    except:`n        return []`n`ndef send_heartbeat():`n    try:`n        hb_data = {`n            'hostname': socket.gethostname(),`n            'ip': socket.gethostbyname(socket.gethostname()),`n            'gpus': get_gpu_stats(),`n            'updated_at': datetime.now().isoformat(),`n            'timestamp_unix': time.time(),`n            'version': VERSION`n        }`n        r.set(WIN_HEARTBEAT_KEY, json.dumps(hb_data), ex=45)`n    except Exception as e:`n        logger.error(f'Heartbeat failed: {e}')`n`ndef get_duration(input_path):`n    try:`n        cmd = ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=noprint_wrappers=1:nokey=1', input_path]`n        return float(subprocess.check_output(cmd).decode().strip())`n    except: return 0`n`ndef transcode_gpu_group(gpu_id, streams, input_path, output_dir, job_id, total_duration):`n    try:`n        num_streams = len(streams)`n        if num_streams == 0: return True`n        `n        stream_names = \", \".join([s['name'] for s in streams])`n        logger.info(f\"GPU {gpu_id} starting group: {stream_names}\")`n        `n        # Build filter_complex with hardware scaling`n        filter_parts = [f\"[0:v]split={num_streams}\"]`n        for i in range(num_streams):`n            filter_parts[0] += f\"[v{i}]\"`n        `n        for i, s in enumerate(streams):`n            filter_parts.append(f\"[v{i}]scale_cuda={s['w']}:{s['h']}[v{i}out]\")`n        `n        filter_complex = \"; \".join(filter_parts)`n        `n        cmd = [`n            FFMPEG_PATH, '-hide_banner', '-y', '-progress', 'pipe:1',`n            '-hwaccel', 'cuda', '-hwaccel_device', str(gpu_id),`n            '-hwaccel_output_format', 'cuda',`n            '-extra_hw_frames', '3',`n            '-i', input_path,`n            '-filter_complex', filter_complex`n        ]`n        `n        var_map_parts = []`n        for i, s in enumerate(streams):`n            cmd.extend([`n                '-map', f'[v{i}out]', f'-c:v:{i}', 'h264_nvenc', '-gpu', str(gpu_id),`n                '-preset', 'p4', '-tune', 'hq', '-rc', 'vbr',`n                f'-b:v:{i}', s['vb'], f'-maxrate:v:{i}', s['maxr'], f'-bufsize:v:{i}', s['bufs'],`n                '-map', '0:a:0', f'-c:a:{i}', 'aac', f'-b:a:{i}', '128k', f'-ac:{i}', '2'`n            ])`n            var_map_parts.append(f\"v:{i},a:{i}\")`n            `n        cmd.extend([`n            '-f', 'hls', '-hls_time', '6', '-hls_list_size', '0',`n            '-hls_playlist_type', 'vod',`n            '-hls_segment_filename', os.path.join(output_dir, 'temp_%%v_%%03d.ts'),`n            '-var_stream_map', \" \".join(var_map_parts),`n            '-max_muxing_queue_size', '1024',`n            os.path.join(output_dir, 'temp_%%v.m3u8')`n        ])`n        `n        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)`n        `n        for line in process.stdout:`n            if 'out_time_ms' in line and total_duration > 0:`n                try:`n                    ms = int(line.split('=')[1])`n                    progress = min(99, round((ms / 1000000) / total_duration * 100))`n                    r.hset(f'{HISTORY_PREFIX}{job_id}', 'progress', progress)`n                    aj = r.get(WIN_ACTIVE_JOB_KEY)`n                    if aj:`n                        aj_data = json.loads(aj)`n                        aj_data['progress'] = progress`n                        r.set(WIN_ACTIVE_JOB_KEY, json.dumps(aj_data), ex=300)`n                    else:`n                        # Re-create if expired`n                        job_status = {`n                            'job_id': job_id,`n                            'input_path': input_path,`n                            'status': 'processing',`n                            'worker': 'windows',`n                            'progress': progress,`n                            'started_at': datetime.now().isoformat()`n                        }`n                        r.set(WIN_ACTIVE_JOB_KEY, json.dumps(job_status), ex=300)`n                except: pass`n            elif 'Error' in line or 'failed' in line.lower():`n                logger.warning(f\"FFmpeg GPU {gpu_id} ({stream_names}): {line.strip()}\")`n        `n        process.wait()`n        if process.returncode != 0:`n            logger.error(f\"FFmpeg GPU {gpu_id} failed with rc={process.returncode}\")`n            return False`n        `n        for i, s in enumerate(streams):`n            idx = s['idx']`n            try:`n                m3u8_src = os.path.join(output_dir, f'temp_{i}.m3u8')`n                m3u8_dst = os.path.join(output_dir, f'stream_{idx}.m3u8')`n                if os.path.exists(m3u8_src):`n                    with open(m3u8_src, 'r') as f: content = f.read()`n                    content = content.replace(f'temp_{i}_', f'stream_{idx}_')`n                    with open(m3u8_dst, 'w') as f: f.write(content)`n                    os.remove(m3u8_src)`n                `n                for f in os.listdir(output_dir):`n                    if f.startswith(f'temp_{i}_') and f.endswith('.ts'):`n                        new_f = f.replace(f'temp_{i}_', f'stream_{idx}_')`n                        os.replace(os.path.join(output_dir, f), os.path.join(output_dir, new_f))`n            except Exception as e:`n                logger.error(f\"Failed to rename temp files for stream {idx}: {e}\")`n                return False`n        return True`n    except Exception as e:`n        logger.error(f\"GPU {gpu_id} group failed: {e}\")`n        return False`n`ndef process_job(job):`n    job_id = job['job_id']`n    input_path = job['input_path']`n    `n    rel_input = input_path.replace('/srv/media_raw/', '').replace('/', '\\\\')`n    local_input = 'Z:\\\\' + rel_input`n    `n    folder_name = os.path.basename(os.path.dirname(input_path))`n    if job['type'] == 'movie':`n        local_output_dir = 'Y:\\\\movies\\\\' + folder_name`n    else:`n        local_output_dir = 'Y:\\\\tv\\\\' + folder_name`n        `n    if not os.path.exists(local_output_dir):`n        os.makedirs(local_output_dir, exist_ok=True)`n        `n    logger.info(f'Processing job {job_id}: {local_input}')`n    logger.info(f'Output dir: {local_output_dir}')`n    `n    total_duration = get_duration(local_input)`n    `n    job_status = {`n        'job_id': job_id,`n        'input_path': input_path,`n        'status': 'processing',`n        'worker': 'windows',`n        'progress': 0,`n        'started_at': datetime.now().isoformat()`n    }`n    r.set(WIN_ACTIVE_JOB_KEY, json.dumps(job_status), ex=300)`n    r.hset(f'{HISTORY_PREFIX}{job_id}', mapping=job_status)`n    `n    gpu_groups = {}`n    for s in STREAMS:`n        gid = s['gpu']`n        if gid not in gpu_groups: gpu_groups[gid] = []`n        gpu_groups[gid].append(s)`n        `n    with ThreadPoolExecutor(max_workers=len(gpu_groups)) as executor:`n        futures = [executor.submit(transcode_gpu_group, gid, streams, local_input, local_output_dir, job_id, total_duration) `n                   for gid, streams in gpu_groups.items()]`n        results = [f.result() for f in futures]`n        `n    if all(results):`n        master_content = '#EXTM3U\\n#EXT-X-VERSION:3\\n'`n        for s in STREAMS:`n            bandwidth = int(s['vb'].replace('k', '')) * 1000`n            master_content += f'#EXT-X-STREAM-INF:BANDWIDTH={bandwidth},RESOLUTION={s[\"w\"]}x{s[\"h\"]}\\nstream_{s[\"idx\"]}.m3u8\\n'`n            `n        with open(os.path.join(local_output_dir, 'master.m3u8'), 'w') as f:`n            f.write(master_content)`n            `n        flag_data = {`n            'job_id': job_id,`n            'status': 'completed',`n            'completed_at': datetime.now().isoformat(),`n            'worker': 'windows'`n        }`n        with open(os.path.join(local_output_dir, 'transcode_complete.flag'), 'w') as f:`n            f.write(json.dumps(flag_data))`n            `n        r.hset(f'{HISTORY_PREFIX}{job_id}', 'status', 'completed')`n        r.hset(f'{HISTORY_PREFIX}{job_id}', 'completed_at', datetime.now().isoformat())`n        r.hset(f'{HISTORY_PREFIX}{job_id}', 'progress', 100)`n        logger.info(f'Job {job_id} completed successfully')`n    else:`n        r.hset(f'{HISTORY_PREFIX}{job_id}', 'status', 'failed')`n        r.hset(f'{HISTORY_PREFIX}{job_id}', 'error', 'One or more GPU groups failed')`n        logger.error(f'Job {job_id} failed')`n    `n    r.delete(WIN_ACTIVE_JOB_KEY)`n`ndef main():`n    global r`n    logger.info(f'=== Windows Worker Agent v{VERSION} starting ===')`n    logger.info(f'Redis: {REDIS_HOST}:{REDIS_PORT}')`n    logger.info(f'Queue: {WINDOWS_QUEUE}')`n    logger.info(f'GPUs: GTX 1050 Ti x2 | GPU0=1080p+360p | GPU1=720p+480p')`n    logger.info(f'Mode: 1 FFmpeg process per GPU (Optimized Grouping)')`n    while True:`n        try:`n            send_heartbeat()`n            `n            if not os.path.exists('Z:'):`n                logger.warning('Z: drive missing, attempting to remap...')`n                os.system('net use Z: \\\\\\\\192.168.0.103\\\\media_raw /user:transcoder TranscoderSMB2024! /persistent:yes')`n            if not os.path.exists('Y:'):`n                logger.warning('Y: drive missing, attempting to remap...')`n                os.system('net use Y: \\\\\\\\192.168.0.103\\\\win_output /user:transcoder TranscoderSMB2024! /persistent:yes')`n                `n            job_raw = r.blpop(WINDOWS_QUEUE, timeout=10)`n            if job_raw:`n                try:`n                    job = json.loads(job_raw[1])`n                    process_job(job)`n                except Exception as e:`n                    logger.error(f'Error processing job: {e}')`n        except redis.ConnectionError:`n            logger.error(\"Redis connection lost. Reconnecting...\")`n            time.sleep(5)`n            r = redis.Redis(host=REDIS_HOST, port=REDIS_PORT, password=REDIS_PASSWORD, decode_responses=True)`n        except Exception as e:`n            logger.error(f\"Unexpected error: {e}\")`n            time.sleep(5)`n        time.sleep(1)`n`nif __name__ == \"__main__\":`n    main()`n'@; `
  [System.IO.File]::WriteAllText('C:\transcoder\windows_worker.py', $content)"
